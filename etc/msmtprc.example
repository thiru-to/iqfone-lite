# Deploy to /etc/msmtprc, root-owned, chmod 600.
# Password is the Cloudflare API token with "Email Sending: Edit".

defaults
logfile        /var/log/msmtp.log

account        cloudflare
host           smtp.mx.cloudflare.net
port           465
tls            on
tls_starttls   off
auth           on
user           api_token
password       REPLACE_ME
from           voicemail@example.com

account default : cloudflare
