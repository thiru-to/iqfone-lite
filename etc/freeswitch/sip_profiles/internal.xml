<profile name="internal">
  <settings>
    <param name="context" value="default"/>
    <param name="sip-ip" value="$${local_ip_v4}"/>
    <param name="rtp-ip" value="$${local_ip_v4}"/>

    <!-- must be the Reserved IP, not the instance address, or SDP advertises the wrong host -->
    <param name="ext-sip-ip" value="$${reserved_ip}"/>
    <param name="ext-rtp-ip" value="$${reserved_ip}"/>

    <param name="sip-port" value="5060"/>
    <param name="tls" value="true"/>
    <param name="tls-only" value="true"/>
    <param name="tls-bind-params" value="transport=tls"/>
    <param name="tls-sip-port" value="5061"/>
    <param name="tls-cert-dir" value="/etc/freeswitch/tls"/>
    <param name="tls-version" value="tlsv1.2,tlsv1.3"/>

    <param name="auth-calls" value="true"/>
    <param name="auth-all-packets" value="false"/>
    <param name="apply-nat-acl" value="rfc1918"/>

    <param name="rtp-secure-media" value="true"/>
    <param name="inbound-codec-prefs" value="$${global_codec_prefs}"/>
    <param name="outbound-codec-prefs" value="$${global_codec_prefs}"/>
    <param name="inbound-late-negotiation" value="true"/>
    <param name="inbound-zrtp-passthru" value="false"/>

    <param name="dialplan" value="XML"/>
    <param name="user-agent-string" value="iqfone"/>
    <param name="hold-music" value="local_stream://moh"/>

    <param name="rtp-timeout-sec" value="300"/>
    <param name="rtp-hold-timeout-sec" value="1800"/>
    <param name="rtp-autofix-timing" value="true"/>
    <param name="disable-transcoding" value="false"/>

    <param name="nat-options-ping" value="true"/>
    <param name="all-reg-options-ping" value="true"/>
    <param name="aggressive-nat-detection" value="true"/>
    <param name="NDLB-received-in-nat-reg-contact" value="true"/>
    <param name="force-register-domain" value="$${sip_domain}"/>
    <param name="force-subscription-domain" value="$${sip_domain}"/>
    <param name="force-register-db-domain" value="$${sip_domain}"/>

    <param name="manage-presence" value="false"/>
    <param name="watchdog-enabled" value="false"/>
  </settings>
</profile>
