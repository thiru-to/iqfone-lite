# Secrets inventory (P11). Copy to secrets.env, fill in, chmod 600, never commit.
# Deployed to the box separately from the config tree.

# Postgres — also embedded in etc/freeswitch/vars.local.xml as pg_dsn
PG_PASSWORD=

# FreeSWITCH event socket — also in etc/freeswitch/autoload_configs/event_socket.conf.xml
ESL_PASSWORD=

# Cloudflare Email Sending: API token with "Email Sending: Edit". SMTP password.
# Username is the literal string api_token.
CLOUDFLARE_EMAIL_TOKEN=

# BulkVS API — DID ordering and E911 registration
BULKVS_API_KEY=
BULKVS_API_SECRET=

# Stripe — webhook signature verification
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Provisioning API bearer token. Can create working phone service —
# same risk tier as the Stripe key.
PROVISIONING_API_TOKEN=
